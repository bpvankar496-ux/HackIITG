# Copy to .env.local and fill in. Never commit real keys.

# Supabase (one set of variables, read by both the browser and the server)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (OCR and research assistant). Server only.
GEMINI_API_KEY=
# Optional: override model names if the defaults are not available to your key
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

APP_URL=http://localhost:3000
PORT=3000

# Dev only: allow /api calls without signing in. Ignored when NODE_ENV=production.
ALLOW_ANONYMOUS_API=false
